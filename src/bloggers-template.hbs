{{#each bloggers}}
<li class="item">
    <img src="{{image}}" alt="" class="images__media">
    <h2 class="title__name">{{name}}</h2>
    <h3 class="region__socials">{{platform}}</h3>
    <p class="text__platform">{{description}}</p>
    <p class="subscribes__socials">{{followers}}</p>
</li>
{{/each}}
