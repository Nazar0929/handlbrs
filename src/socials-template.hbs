 {{#each socials}}
<li class="item">
    <img src="{{image}}" alt="" class="images__socials">
    <h2 class="title__socials">{{name}}</h2>
    <p class="text__socials">{{description}}</p>
    <h3 class="region__socials">{{top_earning_region}}</h3>
    <p class="downloads__socials">{{downloads}}</p>
</li>
  {{/each}}